# ==============================================================================
# LowStudy Production & Development Environment Configuration
# ==============================================================================
# SECURITY CRITICAL:
# - NEVER commit secrets or production values to version control.
# - NEVER prefix database passwords, secret keys, or backend credentials with NEXT_PUBLIC_.
#   Any variable with NEXT_PUBLIC_ is bundled into client-side JS and publicly visible.
# ==============================================================================

# 1. Database Connection
# SQLite for local development: "file:./dev.db"
# PostgreSQL/MySQL for production: "postgresql://user:password@localhost:5432/lowstudy?schema=public"
DATABASE_URL="file:./dev.db"

# 2. Session & Authentication Secrets
# Cryptographically secure random 32+ byte string used for HMAC-SHA256 session token signatures.
# Generate via: openssl rand -hex 32
SESSION_SECRET="replace-with-a-cryptographically-secure-random-64-char-hex-string"

# 3. Administrative API Secret Key
# Used for server-to-server programmatic administrative operations and protected internal endpoints.
# Must be passed as: Authorization: Bearer <ADMIN_SECRET> or x-admin-key: <ADMIN_SECRET>
ADMIN_SECRET="replace-with-a-secure-random-admin-secret-key"

# 4. Automated Cron Secret
# Used to authenticate scheduled cron jobs (e.g. syllabus sync).
# Pass as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-a-secure-random-cron-secret-key"

# 5. Node Runtime Environment
# Must be 'production' on live deployment servers to enforce strict HSTS and secure cookies.
NODE_ENV="development"
